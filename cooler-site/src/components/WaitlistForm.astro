---
import { APP_URL, ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang; id: string; source: string; label?: string; button?: string; buttonClass?: string }
const { lang, id, source, label, button, buttonClass = 'btn btn-outline' } = Astro.props;
const t = ui[lang];
const text = label ?? (APP_URL ? t.emailLabelLive : t.emailLabel);
const errorText = lang === 'ru'
  ? 'Не получилось отправить. Попробуйте ещё раз через минуту.'
  : 'Something went wrong. Please try again in a minute.';
---
<!--
  Netlify Forms: Netlify finds this form in the built HTML (data-netlify="true").
  Submissions show up in Netlify → Forms → waitlist.
  The script below sends the form in the background and then opens the thank-you page,
  so the visitor never sees a blank screen.
-->
<form
  class="waitlist"
  name="waitlist"
  method="POST"
  action={t.thanks}
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-track-place={source}
>
  <input type="hidden" name="form-name" value="waitlist" />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="source" value={source} />
  <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
  <label class="field-label" for={id}>{text}</label>
  <div class="field-row">
    <input class="input" id={id} name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
    <button class={buttonClass} type="submit">{button ?? t.emailButton}</button>
  </div>
  <p class="form-error" role="alert" hidden>{errorText}</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form.waitlist').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const err = form.querySelector<HTMLElement>('.form-error');
      if (btn) btn.disabled = true;
      if (err) err.hidden = true;
      form.dispatchEvent(new CustomEvent('waitlist:submit'));
      try {
        const body = new URLSearchParams(new FormData(form) as any).toString();
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        form.dispatchEvent(new CustomEvent('waitlist:ok'));
        await ((window as any).coolerFlush?.() ?? Promise.resolve());
        window.location.assign(form.getAttribute('action') || '/thanks/');
      } catch (x) {
        form.dispatchEvent(new CustomEvent('waitlist:fail', { detail: String((x as Error)?.message || 'network').slice(0, 40) }));
        if (err) err.hidden = false;
        if (btn) btn.disabled = false;
      }
    });
  });
</script>

<style>
  .form-error { margin-top: 10px; font-size: 18px; color: var(--brick-ink); }
  button[disabled] { opacity: 0.6; cursor: wait; }
</style>
