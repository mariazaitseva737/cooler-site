---
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const lang = Astro.props.lang;
const t = ui[lang];
// After payment the checkout sends people to /thanks/?paid=1 (set this as the redirect URL in Lemon Squeezy or Paddle).
const paid = lang === 'ru'
  ? { title: 'Добро пожаловать!', text: 'Оплата прошла. Мы напишем вам на почту в течение дня и расскажем, что дальше.' }
  : { title: 'Welcome, founding member!', text: 'Your payment went through. We’ll email you within a day with what happens next.' };
---
<section class="wrap thanks">
  <h1 data-thanks-title>{t.thanksTitle}</h1>
  <p data-thanks-text>{t.thanksText}</p>
  <a class="btn btn-primary" href={t.home}>{t.backHome}</a>
</section>
<script is:inline define:vars={{ paid }}>
  if (new URLSearchParams(location.search).get('paid') === '1') {
    var h = document.querySelector('[data-thanks-title]');
    var p = document.querySelector('[data-thanks-text]');
    if (h) h.textContent = paid.title;
    if (p) p.textContent = paid.text;
  }
</script>
<style>
  .thanks { padding-block: clamp(64px, 12vw, 160px); display: grid; gap: 24px; justify-items: start; }
  h1 { font: 600 clamp(40px, 6vw, 72px)/1.05 var(--serif); }
  p { font-size: 22px; }
</style>
