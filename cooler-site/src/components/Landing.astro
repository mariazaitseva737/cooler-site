---
// English landing. The Russian one (switched off for the US test) is in LandingRu.astro.
import WaitlistForm from './WaitlistForm.astro';
import AppScreen from './AppScreen.astro';
import { APP_URL, CHECKOUT_URL, FOUNDING_PRICE, FULL_PRICE_YEAR, PIXEL_ON, appHref, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const tryHref = appHref(lang);

const copy = {
  kicker: 'For women after menopause',
  h1: 'Feel like yourself again after menopause',
  sub: 'Symptoms, health and everything that makes you feel alive. One app, five minutes a day.',
  // Hero copy per ad. The ad link carries utm_content=a_normal | b_body | c_doctor.
  variants: {
    a_normal: {
      kicker: 'Life after menopause',
      sub: 'So many new questions come up after menopause: what’s normal, what isn’t, and when it’s worth calling a doctor. Cooler gives you clear, calm answers and a 10-second daily check-in.',
    },
    b_body: {
      kicker: 'For women after 50',
      sub: 'Menopause isn’t the end of feeling good in your body. Cooler is a short daily practice: 15-minute strength sessions you can do at home with a chair, calm breathing, and a one-tap check-in that shows what helps you.',
    },
    c_doctor: {
      kicker: 'Before your next appointment',
      sub: 'HRT after menopause comes with a lot of questions. Keep a simple medication diary, see how you feel week to week, and bring a clear one-page summary to your doctor.',
    },
  },
  signupLabel: 'Get early access',
  signupButton: 'Join free',
  signupNote: 'Free. Only practices and app news, unsubscribe in one click. Or open the app right away:',
  testLink: 'Wondering if what you feel is normal? See how much symptoms affect you, 2 minutes',
  heroShotAlt: 'Cooler’s morning screen: today’s tarot card, a personal astrology note, words for the day, a 10-minute dance practice and a one-tap check-in',

  notAloneTitle: 'Sound familiar?',
  situations: [
    'You wake up at 3 a.m., drenched.',
    'A simple word disappears mid-sentence.',
    'Your doctor says “it’s just your age.”',
  ],

  symptomsTitle: 'What Cooler helps with',
  symptoms: [
    ['Hot flashes', 'Two-minute breathing the moment one starts'],
    ['Sleep', 'Fewer night sweats, calmer evenings'],
    ['Mood and anxiety', 'Short practices for hard days'],
    ['Brain fog', 'Games for memory and focus'],
    ['Joints and weight', 'Gentle strength and movement'],
    ['Bones and heart', 'Checks and reminders on time'],
    ['Intimacy', 'Dryness and pelvic floor, privately'],
    ['HRT and doctors', 'A one-page summary for your visit'],
  ],

  allTitle: 'Not just a tracker. Everything you need, in one place.',
  allLead: 'Health first. Then body, mind and the inner life.',
  ready: 'Ready now',
  soon: 'Coming soon',
  want: 'I want this',
  wanted: 'Noted. You’ll get it first.',
  pillars: [
    {
      id: 'health',
      title: 'Menopause & health',
      line: 'Symptoms, treatment, checkups',
      modules: [
        ['checkin', 'Daily check-in', 'One tap. Patterns after a week.', 1],
        ['hotflash', 'Hot flash breathing', 'Two minutes, one button.', 1],
        ['meds', 'HRT and medication diary', 'Discreet reminders.', 1],
        ['doctor', 'Summary for your doctor', '30 days on one page.', 1],
        ['sleep', 'Sleep program', 'For night sweats and early waking.', 0],
        ['checkups', 'Bones and heart checkups', 'What to check and when.', 0],
      ],
    },
    {
      id: 'body',
      title: 'Body',
      line: 'Strength, dance, pelvic floor',
      modules: [
        ['strength', 'Strength for bones', '15 minutes, a chair and a wall.', 1],
        ['dance', 'Dance practices', '10 minutes with a dance coach.', 0],
        ['pelvic', 'Pelvic floor', 'For leaking and intimacy.', 0],
      ],
    },
    {
      id: 'mind',
      title: 'Mind',
      line: 'Calm, focus, memory',
      modules: [
        ['meditation', 'Meditations', 'For sleep, worry and hard days.', 0],
        ['brain', 'Brain training', 'Five-minute memory games.', 0],
        ['affirmations', 'Affirmations', 'One sentence for the day.', 0],
        ['subliminals', 'Subliminals', 'Music for walks and sleep.', 0],
      ],
    },
    {
      id: 'soul',
      title: 'Inner world',
      line: 'Astrology, tarot, rituals',
      modules: [
        ['astrology', 'Personal astrology', 'From your birth chart, daily.', 0],
        ['tarot', 'Card of the day', 'One card, a short reading.', 0],
        ['rituals', 'Esoteric practices', 'Moon rituals and intentions.', 0],
      ],
    },
  ] as { id: string; title: string; line: string; modules: [string, string, string, number][] }[],

  morningTitle: 'Five minutes every morning',
  morningLead: '',
  screens: [
    ['today', 'Your morning', 'Check-in, card and one practice.'],
    ['card', 'Card of the day', 'A short reading for today.'],
    ['sky', 'Your sky', 'Your chart plus how you slept.'],
    ['practices', 'Practices', 'Sorted by the time you have.'],
  ],

  astroKicker: 'Personal astrology',
  astroTitle: 'Astrology that knows you',
  astroText: 'Written every morning for you, not for a whole sign.',
  astroPoints: [
    ['Your full chart', 'Birth date, time and city.'],
    ['Your real day', 'Takes in how you slept and feel.'],
    ['Your own questions', 'Ask anything, in your own words.'],
  ],

  diffTitle: 'Not articles. Something to do.',
  diffs: [
    ['Help in the moment', 'One button when a hot flash starts.'],
    ['Made for you', 'Built around your check-ins and your chart.'],
    ['Private', 'Your logs stay on your phone.'],
  ],
  breatheIdle: 'Try it now: two slow breaths, in for 4, out for 6.',
  breatheIn: 'Breathe in',
  breatheOut: 'Breathe out',
  breatheDone: 'That’s it. In the app, this starts with one tap when a hot flash begins.',
  breatheStart: 'Breathe with me',
  breatheStop: 'Stop',
  breatheAgain: 'Again',

  pricingTitle: 'Start free. Become a founding member if it helps.',
  plans: [
    {
      name: 'Free',
      price: '$0',
      per: 'always',
      points: ['10-second daily check-in', '“Hot flash started” breathing', 'Clear answers to “is this normal?”', 'Medication diary'],
      cta: 'Start free',
    },
    {
      name: 'Founding member',
      price: `$${FOUNDING_PRICE}`,
      per: `for your first year, then $${FULL_PRICE_YEAR} a year`,
      points: ['Everything in Free', 'Your personal astrology reading and card of the day, every morning', 'Every practice as it launches: dance, meditation, brain training, subliminals, rituals, strength and pelvic floor', 'One-page summary for your doctor', 'New modules first, and a say in what we build next'],
      cta: 'Become a founding member',
      refund: 'Full refund any time in your first 30 days.',
    },
  ],
  checkoutSoon: 'Founding membership opens in a few days. Leave your email above and we’ll send you the link first, at the same price.',

  intimateTitle: 'Intimate health, without the awkwardness',
  intimateText: 'After menopause, many women notice dryness, discomfort or pain during sex, or a little leaking when they cough or laugh. It usually doesn’t go away on its own, but it can almost always be treated. And sex after menopause is completely normal.',
  intimatePoints: [
    'This section only opens when you choose to open it',
    'Notifications on your lock screen never mention anything intimate',
    'Pelvic floor exercises on a simple schedule',
    'Plain words and questions to bring it up with your doctor',
  ],

  privacyTitle: 'Your data stays with you',
  privacyText: 'We don’t keep your logs at all.',
  privacyCards: [
    ['Logs stay on your phone', 'Symptoms, medicines and intimate notes never reach our servers.'],
    ['Birth details', 'Only date, time and city go to our AI provider to write your reading. Never your name or health data.'],
    PIXEL_ON
      ? ['Nothing sold', 'The Meta pixel on this website sees page visits only, never anything from the app.']
      : ['Nothing sold', 'Not to advertisers, not to anyone.'],
    ['What we count', 'Page and screen visits in Amplitude, without IP addresses.'],
  ],

  faqTitle: 'Questions',
  faq: [
    ['Do I have to use all of it?', 'No. In the first minute you pick what speaks to you. Some women only want dance and the check-in, others start every day with their card. Everything else stays out of the way.'],
    ['Do astrology and tarot mix with the health advice?', 'No. Your card and your reading are for reflection and mood. Anything about your health lives in the Health section, where we stick to what research says.'],
    ['My last period was more than 5 years ago. Is this for me?', 'Yes. Your hot flashes may be over, but your body, your mind and your sleep still deserve care. Most of Cooler isn’t about symptoms at all.'],
    ['Do I need to download anything?', 'No. The app opens in your phone’s browser. You can add it to your home screen, and we’ll show you how.'],
    ['I’m not great with apps', 'We kept that in mind. The text is large, the buttons are big, and every icon has a label. Your morning takes about five minutes.'],
    ['Do you recommend hormone therapy?', 'We explain what’s known about it, without scare stories and without selling anything. Whether it’s right for you is up to you and your doctor.'],
  ],
  ctaTitle: 'Try it tomorrow morning. It takes five minutes.',
  ctaText: 'It’s free, and you don’t need to sign up.',
};
---
<section class="hero-band" data-section="hero">
  <div class="wrap hero">
    <div class="hero-text">
      <p class="kicker" data-hero-kicker>{copy.kicker}</p>
      <h1 class="hero-title">{copy.h1}</h1>
      <p class="hero-sub" data-hero-sub>{copy.sub}</p>
      <div class="hero-actions" id="waitlist">
        <WaitlistForm lang={lang} id="hero-email" source="hero" label={copy.signupLabel} button={copy.signupButton} buttonClass="btn btn-primary" />
        {APP_URL && <a class="hero-try" href={tryHref} data-track="try_app" data-track-place="hero">{t.tryFree}</a>}
      </div>
    </div>
    <div class="hero-phone" data-shot="hero_today">
      <AppScreen screen="today" label={copy.heroShotAlt} />
    </div>
  </div>
</section>
<script is:inline define:vars={{ variants: copy.variants }}>
  (function () {
    var v = new URLSearchParams(location.search).get('utm_content');
    var c = v && variants[v];
    if (!c) return;
    var k = document.querySelector('[data-hero-kicker]');
    var p = document.querySelector('[data-hero-sub]');
    if (k) k.textContent = c.kicker;
    if (p) p.textContent = c.sub;
    document.body.dataset.heroVariant = v;
  })();
</script>

<section class="section section-white" data-section="not_alone">
  <div class="wrap stack-40">
    <h2 class="h-section">{copy.notAloneTitle}</h2>
    <ul class="situations">
      {copy.situations.map((x) => <li>{x}</li>)}
    </ul>
  </div>
</section>

<section class="section" id="symptoms" data-section="symptoms">
  <div class="wrap stack-40">
    <h2 class="h-section">{copy.symptomsTitle}</h2>
    <ul class="symptoms" role="list">
      {copy.symptoms.map(([h, p]) => <li><strong>{h}</strong><span>{p}</span></li>)}
    </ul>
  </div>
</section>

<section class="section section-white" id="features" data-section="all_in_one">
  <div class="wrap stack-56">
    <div class="stack-24 narrow">
      <h2 class="h-section">{copy.allTitle}</h2>
      <p class="lead">{copy.allLead}</p>
    </div>
    <div class="pillars">
      {copy.pillars.map((p, pi) => (
        <section class="pillar" id={`pillar-${p.id}`} data-section={`pillar_${p.id}`} aria-labelledby={`pillar-${p.id}-h`}>
          <header class="pillar-head">
            <span class="pillar-num serif">{String(pi + 1).padStart(2, '0')}</span>
            <h3 id={`pillar-${p.id}-h`} class="serif">{p.title}</h3>
            <p>{p.line}</p>
          </header>
          <ul class="modules" role="list">
            {p.modules.map(([id, name, desc, ready]) => (
              <li class="module">
                <div class="module-top">
                  <h4>{name}</h4>
                  <span class={ready ? 'tag tag-ready' : 'tag'}>{ready ? copy.ready : copy.soon}</span>
                </div>
                <p>{desc}</p>
                {!ready && (
                  <button class="want" type="button" data-want data-track="module_interest" data-track-place={id}>{copy.want}</button>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>
<script is:inline define:vars={{ wanted: copy.wanted }}>
  document.querySelectorAll('[data-want]').forEach(function (b) {
    b.addEventListener('click', function () {
      b.textContent = wanted;
      b.disabled = true;
      b.classList.add('is-done');
    });
  });
</script>

<section class="section section-deep" id="screens" data-section="screens">
  <div class="wrap stack-56">
    <div class="stack-24 narrow">
      <h2 class="h-section">{copy.morningTitle}</h2>
    </div>
    <ul class="shots" role="list">
      {copy.screens.map(([id, h, p]) => (
        <li data-shot={id}>
          <AppScreen screen={id as any} label={`${h}. ${p}`} />
          <h3>{h}</h3>
          <p>{p}</p>
        </li>
      ))}
    </ul>
    {APP_URL && <a class="btn btn-light btn-lg shots-cta" href={tryHref} data-track="try_app" data-track-place="screens">{t.tryFree}</a>}
  </div>
</section>

<section class="section section-white" id="astrology" data-section="astrology">
  <div class="wrap astro">
    <div class="stack-24">
      <p class="kicker">{copy.astroKicker}</p>
      <h2 class="h-section">{copy.astroTitle}</h2>
      <p class="lead">{copy.astroText}</p>
      <button class="btn btn-outline want-lg" type="button" data-want data-track="module_interest" data-track-place="astrology_block">{copy.want}</button>
    </div>
    <dl class="plain-list">
      {copy.astroPoints.map(([h, p]) => (
        <div><dt>{h}</dt><dd>{p}</dd></div>
      ))}
    </dl>
  </div>
</section>

<section class="section" id="why" data-section="why">
  <div class="wrap why">
    <h2 class="h-section why-title">{copy.diffTitle}</h2>
    <div class="breathe" data-breathe data-section="breathe_demo">
      <div class="breathe-stage" aria-hidden="true">
        <span class="breathe-ring"></span>
        <span class="breathe-core"></span>
        <span class="breathe-count serif" data-breathe-count></span>
      </div>
      <p class="breathe-cue" data-breathe-cue aria-live="polite">{copy.breatheIdle}</p>
      <button class="btn btn-primary" type="button" data-breathe-btn data-track="breathe_demo" data-track-place="why">{copy.breatheStart}</button>
    </div>
    <dl class="diffs plain-list">
      {copy.diffs.map(([h, p]) => (
        <div><dt>{h}</dt><dd>{p}</dd></div>
      ))}
    </dl>
  </div>
</section>
<script is:inline define:vars={{ L: { idle: copy.breatheIdle, inn: copy.breatheIn, out: copy.breatheOut, done: copy.breatheDone, start: copy.breatheStart, stop: copy.breatheStop, again: copy.breatheAgain } }}>
  (function () {
    var root = document.querySelector('[data-breathe]');
    if (!root) return;
    var btn = root.querySelector('[data-breathe-btn]');
    var cue = root.querySelector('[data-breathe-cue]');
    var count = root.querySelector('[data-breathe-count]');
    var timers = [];
    var running = false;
    function clear() { timers.forEach(clearTimeout); timers = []; }
    function at(ms, fn) { timers.push(setTimeout(fn, ms)); }
    function phase(t0, secs, word, cls) {
      at(t0, function () { root.className = 'breathe ' + cls; cue.textContent = word; });
      for (var i = 0; i < secs; i++) (function (n) { at(t0 + n * 1000, function () { count.textContent = String(secs - n); }); })(i);
    }
    function stop(finished) {
      clear(); running = false;
      root.className = 'breathe';
      count.textContent = '';
      cue.textContent = finished ? L.done : L.idle;
      btn.textContent = finished ? L.again : L.start;
    }
    btn.addEventListener('click', function () {
      if (running) { stop(false); return; }
      running = true; btn.textContent = L.stop;
      var t = 0;
      for (var c = 0; c < 2; c++) { phase(t, 4, L.inn, 'is-in'); t += 4000; phase(t, 6, L.out, 'is-out'); t += 6000; }
      at(t, function () { stop(true); });
    });
  })();
</script>

<section class="section section-white" id="pricing" data-section="pricing">
  <div class="wrap stack-56">
    <div class="stack-16 narrow">
      <h2 class="h-section">{copy.pricingTitle}</h2>
    </div>
    <div class="plans">
      {copy.plans.map((plan: any, i: number) => (
        <div class={i === 1 ? 'plan plan-featured' : 'plan'}>
          <h3>{plan.name}</h3>
          <p class="plan-price"><span class="serif">{plan.price}</span> {plan.per}</p>
          <ul class="plan-points">{plan.points.map((pt: string) => <li>{pt}</li>)}</ul>
          {i === 0
            ? (APP_URL && <a class="btn btn-outline" href={tryHref} data-track="try_app" data-track-place="pricing">{plan.cta}</a>)
            : (CHECKOUT_URL
                ? <a class="btn btn-primary" href={CHECKOUT_URL} data-checkout data-price={FOUNDING_PRICE} data-track="founding_checkout" data-track-place="pricing">{plan.cta}</a>
                : <button class="btn btn-primary" type="button" data-checkout data-checkout-soon data-price={FOUNDING_PRICE} data-track="founding_checkout" data-track-place="pricing">{plan.cta}</button>)}
          {plan.refund && <p class="plan-refund">{plan.refund}</p>}
          {i === 1 && !CHECKOUT_URL && <p class="plan-soon" data-checkout-msg hidden>{copy.checkoutSoon}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
{!CHECKOUT_URL && (
  <script is:inline>
    document.querySelectorAll('[data-checkout-soon]').forEach(function (b) {
      b.addEventListener('click', function () {
        var m = document.querySelector('[data-checkout-msg]');
        if (m) m.hidden = false;
      });
    });
  </script>
)}

<section class="wrap" id="intimate" data-section="intimate">
  <div class="intimate">
    <div class="stack-24">
      <h2 class="h-section">{copy.intimateTitle}</h2>
      <p class="intimate-text">{copy.intimateText}</p>
    </div>
    <ul class="checks">
      {copy.intimatePoints.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<section class="section" id="privacy" data-section="privacy">
  <div class="wrap two-col">
    <div class="stack-24">
      <h2 class="h-section">{copy.privacyTitle}</h2>
      <p class="lead">{copy.privacyText}</p>
    </div>
    <dl class="plain-list">
      {copy.privacyCards.map(([h, p]) => (
        <div><dt>{h}</dt><dd>{p}</dd></div>
      ))}
    </dl>
  </div>
</section>

<section class="section section-white" id="faq" data-section="faq">
  <div class="wrap two-col">
    <h2 class="h-section">{copy.faqTitle}</h2>
    <div class="faq" data-faq>
      {copy.faq.map(([q, a], i) => (
        <details open={i === 0}>
          <summary>{q}<span class="plus" aria-hidden="true">+</span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section cta" data-section="bottom_cta">
  <div class="wrap stack-24 center">
    <h2 class="h-section">{copy.ctaTitle}</h2>
    <p class="lead">{copy.ctaText}</p>
    {APP_URL
      ? <a class="btn btn-primary btn-lg" href={tryHref} data-track="try_app" data-track-place="bottom">{t.tryFree}</a>
      : <div class="cta-form"><WaitlistForm lang={lang} id="bottom-email" source="bottom" buttonClass="btn btn-primary" /></div>}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: copy.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
})} />

<style>
  .stack-16 { display: grid; gap: 16px; }
  .stack-24 { display: grid; gap: 24px; align-content: start; }
  .stack-56 { display: grid; gap: clamp(32px, 5vw, 56px); }
  .narrow { max-width: 900px; }
  .stack-40 { display: grid; gap: clamp(24px, 3.5vw, 40px); }
  .center { justify-items: center; text-align: center; }

  /* Hero */
  .hero-band { background: linear-gradient(180deg, var(--white) 0%, var(--air) 100%); border-bottom: 1px solid var(--line-soft); }
  .hero { padding-block: clamp(40px, 6vw, 88px) clamp(56px, 7vw, 104px); display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 5vw, 96px); align-items: center; }
  .hero-text { display: grid; gap: 26px; }
  .hero-phone { width: clamp(270px, 24vw, 340px); }
  @media (max-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero-phone { width: min(310px, 80vw); justify-self: center; }
  }
  .hero-title { font: 700 clamp(38px, 5vw, 64px)/1.1 var(--sans); letter-spacing: -0.015em; max-width: 16ch; color: var(--ink); }
  .hero-try { justify-self: start; font-size: 19px; font-weight: 600; text-underline-offset: 5px; }
  .hero-sub { font-size: clamp(19px, 1.9vw, 22px); line-height: 1.6; max-width: 640px; color: var(--ink-2); }
  .hero-actions { display: grid; gap: 18px; max-width: 640px; padding-top: 4px; scroll-margin-top: 24px; }
  .hero-test { justify-self: start; font-size: 19px; font-weight: 600; text-underline-offset: 5px; }
  .hero-secondary { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .note { font-size: 17px; color: var(--ink-soft); }

  /* Not alone */
  .situations { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 28px clamp(32px, 5vw, 64px); }
  .situations li { border-top: 2px solid var(--lagoon); padding-top: 16px; font-size: clamp(20px, 2vw, 24px); line-height: 1.4; font-weight: 600; }
  .symptoms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .symptoms li { background: var(--white); border: 1px solid var(--line-soft); border-radius: var(--radius); padding: 20px; display: grid; gap: 6px; }
  .symptoms strong { font-size: 21px; }
  .symptoms span { font-size: 18px; color: var(--ink-soft); line-height: 1.4; }
  .closing { font-size: clamp(24px, 2.6vw, 32px); line-height: 1.35; max-width: 900px; color: var(--lagoon); }

  /* Pillars */
  .pillars { display: grid; gap: clamp(28px, 4vw, 48px); }
  .pillar { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: clamp(20px, 4vw, 64px); padding-top: clamp(24px, 3vw, 36px); border-top: 1px solid var(--ink); }
  .pillar-head { display: grid; gap: 8px; align-content: start; }
  .pillar-num { font-size: 18px; color: var(--gold); letter-spacing: 0.08em; }
