---
import WaitlistForm from './WaitlistForm.astro';
import { APP_NAME, APP_NAME_IN, APP_URL, appHref, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const name = APP_NAME[lang];
const tryHref = appHref(lang);

const copy = {
  ru: {
    kicker: 'Для женщин после менопаузы',
    h1: 'Впереди ещё тридцать лет. Пусть они будут хорошими.',
    sub: `${name} поможет пережить приливы, плохой сон и перепады настроения. А когда они пройдут, напомнит позаботиться о костях, сердце и мышцах. Приложение работает на русском и английском.`,
    shotsKicker: 'Как это выглядит',
    shotsTitle: 'Крупный текст, понятные кнопки, ничего лишнего',
    shots: [
      ['today', 'Главный экран', 'Лекарства на сегодня, отметка дня и кнопка на случай прилива.'],
      ['breathing', 'Начался прилив', 'Две минуты спокойного дыхания: вдох на 4, выдох на 6.'],
      ['trends', 'Динамика', 'Что влияет на приливы и сон именно у вас. Видно уже через неделю.'],
      ['doctor', 'К врачу', 'Итог за 30 дней и ваши вопросы. Можно показать на приёме или отправить.'],
    ],
    heroShotAlt: 'Главный экран приложения: лекарства на сегодня и кнопка «Начался прилив»',
    notAloneTitle: 'Узнаёте себя? Вы не одна',
    notAloneSub: 'Так бывает у очень многих. Просто вслух об этом говорят редко.',
    situations: [
      'Три часа ночи. Вы проснулись мокрая и то сбрасываете одеяло, то снова натягиваете.',
      'Посреди фразы вылетело слово, самое простое. И вы ждёте, когда оно вернётся.',
      'Срываетесь на близких и сами не понимаете почему.',
      'В гостях или на работе вдруг бросает в жар, и хочется скорее выйти на воздух.',
      'По утрам колени и пальцы плохо слушаются, и расходиться приходится дольше, чем раньше.',
      'Врач говорит «это возраст, потерпите», и вы уходите ни с чем.',
    ],
    notAloneEnd: 'У всего этого есть понятные причины. И со многим можно что-то сделать.',
    featuresKicker: 'Возможности',
    featuresTitle: `Что можно делать в ${APP_NAME_IN}`,
    features: [
      ['Переждать прилив', 'Нажмите большую кнопку «Начался прилив», и круг на экране две минуты будет подсказывать, когда вдыхать и когда выдыхать.'],
      ['Отметить день за полминуты', 'Отметьте, как сегодня с приливами, сном, настроением, силами и суставами. Приложение подскажет, что можно сделать с тем, что беспокоит больше всего.'],
      ['Увидеть свои закономерности', 'Через пять отметок вы увидите, что повторяется именно у вас. Например, что после кофе во второй половине дня приливы сильнее.'],
      ['Беречь кости, сердце и силу', 'Программы силовых тренировок, упражнений для тазового дна и для сна. Напоминания о лечении, если вы его получаете, и список обследований, которые пора пройти.'],
      ['Понимать, что происходит', 'Короткие ответы на вопросы, которые неловко или некогда задать врачу. Рядом с русским термином стоит английский: пригодится, если вы лечитесь за границей.'],
    ],
    terms: [['приливы', 'hot flashes'], ['ЗГТ', 'HRT'], ['денситометрия', 'bone density scan']],
    intimateKicker: 'Интимное здоровье',
    intimateTitle: 'Об интимном можно говорить спокойно',
    intimateText: 'После менопаузы у многих появляются сухость, дискомфорт или боль во время секса, а при кашле или смехе может подтекать. Само это обычно не проходит, но почти всегда решается. И секс после менопаузы — это нормально.',
    intimatePoints: [
      'Раздел открывается, только когда вы сами захотите',
      'В уведомлениях на экране не будет интимных слов',
      'Упражнения для тазового дна по простому расписанию',
      'Термины на двух языках, чтобы обсудить это с врачом',
    ],
    privacyKicker: 'Приватность',
    privacyTitle: 'Ваши данные остаются у вас',
    privacyText: 'В приложениях о женском здоровье уже были истории с передачей данных. Поэтому мы решили не хранить ваши отметки у себя вообще.',
    privacyCards: [
      ['Отметки хранятся на вашем телефоне', 'Симптомы, лечение и всё из интимного раздела остаются в браузере на телефоне. К нам на сервер они не попадают.'],
      ['Мы ничего не передаём и не продаём', 'Ни рекламодателям, ни партнёрам, никому.'],
      ['Что мы всё-таки считаем', 'Какие страницы и экраны открывают и сколько людей возвращается. Для этого мы используем сервис Amplitude, IP-адрес не сохраняем. В приложении вы сами решаете, можно ли связывать эти визиты с вами. Записи, давление и лекарства туда не попадают никогда. Email у нас есть, только если вы сами его оставили.'],
    ],
    faqTitle: 'Частые вопросы',
    faq: [
      ['После последних месячных прошло больше 5 лет. Мне подойдёт?', 'Да. Приливы могли уже пройти, а заботиться о костях, мышцах, сердце и сне всё равно нужно. Для этого есть раздел «Моё здоровье».'],
      ['А если месячные были меньше года назад?', 'Возможно, у вас ещё перименопауза, то есть переходный период. Приложение подойдёт и в этом случае: с приливами, сном и настроением оно помогает так же.'],
      ['Нужно что-то скачивать?', 'Нет. Приложение открывается в браузере телефона. Его можно вынести на главный экран, мы покажем, как это сделать.'],
      ['Я не очень дружу с приложениями', 'Мы это учли. Текст крупный, кнопки большие, у каждой иконки есть подпись. Отметка дня занимает полминуты.'],
      ['Вы советуете гормональную терапию?', 'Мы рассказываем, что о ней известно, и не пугаем и не рекламируем. Подходит ли она вам, решаете вы с врачом.'],
    ],
    ctaTitle: 'Попробуйте сегодня. Это займёт минуту.',
    ctaText: 'Это бесплатно, регистрироваться не нужно.',
  },
  en: {
    kicker: 'For women after menopause',
    h1: 'Thirty more years ahead. They can be good ones.',
    sub: `${name} helps you get through hot flashes, bad nights and mood swings. Once those pass, it reminds you to look after your bones, heart and muscles.`,
    shotsKicker: 'What it looks like',
    shotsTitle: 'Large text, clear buttons, nothing extra',
    shots: [
      ['today', 'Today', 'Today’s medicines, a quick check-in and a button for when a hot flash starts.'],
      ['breathing', 'Hot flash started', 'Two minutes of calm breathing: in for 4, out for 6.'],
      ['trends', 'Trends', 'What affects your hot flashes and sleep. You start seeing it after a week.'],
      ['doctor', 'For the doctor', 'A 30-day summary and your questions. Show it at the appointment or send it.'],
    ],
    heroShotAlt: 'The app’s Today screen: medicines for today and a “Hot flash started” button',
    notAloneTitle: 'Sound familiar? You’re not alone',
    notAloneSub: 'It happens to a lot of women. People just rarely say it out loud.',
    situations: [
      'It’s 3 a.m. You wake up drenched and keep kicking the blanket off and pulling it back on.',
      'Halfway through a sentence, a simple word just disappears, and you wait for it to come back.',
      'You snap at the people you love and can’t explain why.',
      'At work or at a friend’s place, a wave of heat hits and all you want is to get outside.',
      'In the morning your knees and fingers are stiff, and it takes longer to get going than it used to.',
      'Your doctor says “it’s just your age, you’ll have to live with it,” and you leave with nothing.',
    ],
    notAloneEnd: 'All of this has real causes. And a lot of it can be helped.',
    featuresKicker: 'Features',
    featuresTitle: `What can you do with the ${name} app?`,
    features: [
      ['Get through a hot flash', 'Tap the big “Hot flash started” button, and a circle on the screen will guide your breathing for two minutes.'],
      ['Log your day in 30 seconds', 'Note how your hot flashes, sleep, mood, energy and joints are today. The app suggests one thing to try for whatever is bothering you most.'],
      ['Spot your own patterns', 'After five check-ins, you’ll see what keeps repeating for you. For example, that your hot flashes are worse on days with afternoon coffee.'],
      ['Look after your bones, heart and strength', 'Programs for strength training, pelvic floor exercises and better sleep. Reminders for your treatment, if you’re on one, and a list of checkups that are due.'],
      ['Understand what’s going on', 'Short, honest answers to the questions you feel awkward about or never get time to ask your doctor.'],
    ],
    terms: [['hot flashes', 'приливы'], ['HRT', 'ЗГТ'], ['bone density scan', 'денситометрия']],
    intimateKicker: 'Intimate health',
    intimateTitle: 'Intimate health, without the awkwardness',
    intimateText: 'After menopause, many women notice dryness, discomfort or pain during sex, or a little leaking when they cough or laugh. It usually doesn’t go away on its own, but it can almost always be treated. And sex after menopause is completely normal.',
    intimatePoints: [
      'This section only opens when you choose to open it',
      'Notifications on your lock screen never mention anything intimate',
      'Pelvic floor exercises on a simple schedule',
      'Plain words and questions to bring it up with your doctor',
    ],
    privacyKicker: 'Privacy',
    privacyTitle: 'Your data stays with you',
    privacyText: 'Women’s health apps have been caught sharing user data before. So we decided not to keep your logs on our side at all.',
    privacyCards: [
      ['Your logs live on your phone', 'Symptoms, treatment and everything in the intimate health section stay in the browser on your phone. They never reach our servers.'],
      ['We don’t share or sell anything', 'Not to advertisers, not to partners, not to anyone.'],
      ['What we do count', 'Which pages and screens get opened, and how many people come back. We use a service called Amplitude for this and don’t store IP addresses. In the app, you decide whether those visits can be linked to you. Your entries, blood pressure and medicines never go there. We only have your email if you gave it to us.'],
    ],
    faqTitle: 'Questions',
    faq: [
      ['My last period was more than 5 years ago. Is this for me?', 'Yes. Your hot flashes may be over, but your bones, muscles, heart and sleep still need looking after. That’s what the “My health” section is for.'],
      ['What if my last period was less than a year ago?', 'You may still be in perimenopause, the transition stage. The app works for that too. It helps with hot flashes, sleep and mood the same way.'],
      ['Do I need to download anything?', 'No. The app opens in your phone’s browser. You can add it to your home screen, and we’ll show you how.'],
      ['I’m not great with apps', 'We kept that in mind. The text is large, the buttons are big, and every icon has a label. Logging your day takes about 30 seconds.'],
      ['Do you recommend hormone therapy?', 'We explain what’s known about it, without scare stories and without selling anything. Whether it’s right for you is up to you and your doctor.'],
    ],
    ctaTitle: 'Try it today. It takes a minute.',
    ctaText: 'It’s free, and you don’t need to sign up.',
  },
}[lang];
---
<section class="wrap hero" data-section="hero">
  <div class="hero-text">
  <p class="kicker">{copy.kicker}</p>
  <h1 class="hero-title">{copy.h1}</h1>
  <p class="hero-sub">{copy.sub}</p>
  <div class="hero-actions" id="waitlist">
    {APP_URL && <a class="btn btn-primary btn-lg" href={tryHref} data-track="try_app" data-track-place="hero">{t.tryFree}</a>}
    <WaitlistForm lang={lang} id="hero-email" source="hero" buttonClass={APP_URL ? 'btn btn-outline' : 'btn btn-primary'} />
    <p class="note">{t.emailNote}</p>
  </div>
  </div>
  <figure class="phone hero-phone" data-shot="hero_today">
    <img src={`/screens/${lang}-today.webp`} width="390" height="844" alt={copy.heroShotAlt} fetchpriority="high" />
  </figure>
</section>

<section class="section section-white" data-section="not_alone">
  <div class="wrap stack-56">
    <div class="stack-16 narrow">
      <h2 class="h-section">{copy.notAloneTitle}</h2>
      <p class="lead">{copy.notAloneSub}</p>
    </div>
    <ul class="situations">
      {copy.situations.map((s) => <li>{s}</li>)}
    </ul>
    <p class="closing serif">{copy.notAloneEnd}</p>
  </div>
</section>

<section class="section section-deep" id="screens" data-section="screens">
  <div class="wrap stack-56 shots-wrap">
    <div class="stack-16 narrow">
      <p class="kicker kicker-light">{copy.shotsKicker}</p>
      <h2 class="h-section">{copy.shotsTitle}</h2>
    </div>
    <ul class="shots" role="list">
      {copy.shots.map(([id, h, p]) => (
        <li data-shot={id}>
          <figure class="phone"><img src={`/screens/${lang}-${id}.webp`} width="390" height="844" alt={`${h}. ${p}`} loading="lazy" decoding="async" /></figure>
          <h3>{h}</h3>
          <p>{p}</p>
        </li>
      ))}
    </ul>
    {APP_URL && <a class="btn btn-glass btn-lg shots-cta" href={tryHref} data-track="try_app" data-track-place="screens">{t.tryFree}</a>}
  </div>
</section>

<section class="section" id="features" data-section="features">
  <div class="wrap stack-56">
    <div class="stack-16 narrow">
      <p class="kicker">{copy.featuresKicker}</p>
      <h2 class="h-section">{copy.featuresTitle}</h2>
    </div>
    <ol class="features">
      {copy.features.map(([h, p], i) => (
        <li>
          <span class="num serif" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{h}</h3>
          <div class="stack-16">
            <p>{p}</p>
            {i === 4 && lang === 'ru' && (
              <ul class="chips" aria-label={lang === 'ru' ? 'Примеры терминов' : 'Example terms'}>
                {copy.terms.map(([a, b]) => <li><strong>{a}</strong> <span>{b}</span></li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="wrap" id="intimate" data-section="intimate">
  <div class="intimate">
    <div class="stack-24">
      <p class="kicker kicker-light">{copy.intimateKicker}</p>
      <h2 class="h-section">{copy.intimateTitle}</h2>
      <p class="intimate-text">{copy.intimateText}</p>
    </div>
    <ul class="checks">
      {copy.intimatePoints.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<section class="section" id="privacy" data-section="privacy">
  <div class="wrap two-col">
    <div class="stack-24">
      <p class="kicker">{copy.privacyKicker}</p>
      <h2 class="h-section">{copy.privacyTitle}</h2>
      <p class="lead">{copy.privacyText}</p>
    </div>
    <div class="stack-16">
      {copy.privacyCards.map(([h, p]) => (
        <div class="card">
          <h3>{h}</h3>
          <p>{p}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section-white" id="faq" data-section="faq">
  <div class="wrap two-col">
    <h2 class="h-section">{copy.faqTitle}</h2>
    <div class="faq" data-faq>
      {copy.faq.map(([q, a], i) => (
        <details open={i === 0}>
          <summary>{q}<span class="plus" aria-hidden="true">+</span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section cta" data-section="bottom_cta">
  <div class="wrap stack-24 center">
    <h2 class="h-section">{copy.ctaTitle}</h2>
    <p class="lead">{copy.ctaText}</p>
    {APP_URL
      ? <a class="btn btn-primary btn-lg" href={tryHref} data-track="try_app" data-track-place="bottom">{t.tryFree}</a>
      : <div class="cta-form"><WaitlistForm lang={lang} id="bottom-email" source="bottom" buttonClass="btn btn-primary" /></div>}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: copy.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
})} />

<style>
  .stack-16 { display: grid; gap: 16px; }
  .stack-24 { display: grid; gap: 24px; align-content: start; }
  .stack-56 { display: grid; gap: clamp(32px, 5vw, 56px); }
  .narrow { max-width: 860px; }
  .center { justify-items: center; text-align: center; }

  .hero { padding-block: clamp(40px, 7vw, 96px) clamp(64px, 8vw, 112px); display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 5vw, 80px); align-items: center; max-width: 1440px; }
  .hero-text { display: grid; gap: 24px; }
  .phone { margin: 0; border-radius: 40px; padding: 10px; background: var(--ink); box-shadow: 0 30px 60px -30px rgba(16, 48, 47, 0.45); }
  .phone img { display: block; width: 100%; height: auto; border-radius: 30px; }
  .hero-phone { width: clamp(260px, 24vw, 340px); transform: rotate(2deg); }
  @media (max-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero-phone { width: min(300px, 78vw); justify-self: center; transform: none; }
  }
  .section-deep { background: var(--lagoon-deep, #0B4446); color: var(--air); }
  .section-deep .h-section { color: var(--air); }
  .shots { list-style: none; padding: 0; margin: 0; min-width: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(20px, 2.5vw, 36px); }
  .shots li { display: grid; gap: 12px; align-content: start; }
  .shots .phone { background: #0A2E2D; box-shadow: none; margin-bottom: 8px; }
  .shots h3 { font: 600 22px/1.25 var(--sans); color: var(--air); }
  .shots p { font-size: 18px; line-height: 1.5; color: #CFE6DF; }
  .shots-wrap { grid-template-columns: minmax(0, 1fr); }
  .shots-cta { justify-self: start; }
  @media (max-width: 1100px) {
    .shots { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(270px, 74vw); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; margin-inline: calc(-1 * var(--gutter, 20px)); padding-inline: var(--gutter, 20px); scroll-padding-inline: var(--gutter, 20px); }
    .shots li { scroll-snap-align: start; }
  }
  .hero-title { font: 600 clamp(40px, 6.4vw, 80px)/1.05 var(--serif); letter-spacing: -0.025em; max-width: 1000px; }
  .hero-sub { font-size: clamp(19px, 2vw, 23px); line-height: 1.55; max-width: 720px; }
  .hero-actions { display: grid; gap: 18px; max-width: 640px; padding-top: 8px; scroll-margin-top: 24px; }
  .hero-actions > .btn { justify-self: start; }
  .note { font-size: 18px; color: var(--ink-soft); }

  .situations { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .situations li { background: var(--air); border-radius: var(--radius); padding: clamp(22px, 3vw, 32px); font-size: clamp(19px, 1.8vw, 22px); line-height: 1.5; }
  .closing { font-size: clamp(24px, 2.6vw, 32px); line-height: 1.35; max-width: 900px; }

  .features { list-style: none; margin: 0; padding: 0; }
  .features > li { display: grid; grid-template-columns: 100px minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px; padding-block: 32px; border-top: 1.5px solid var(--line); align-items: baseline; }
  .features > li:last-child { border-bottom: 1.5px solid var(--line); }
  .features .num { font-size: 40px; color: var(--lagoon); }
  .features h3 { font-size: clamp(24px, 2.4vw, 30px); line-height: 1.25; }
  .features p { font-size: clamp(19px, 1.7vw, 21px); color: var(--ink-2); }
  @media (max-width: 860px) {
    .features > li { grid-template-columns: 1fr; gap: 10px; padding-block: 26px; }
    .features .num { font-size: 28px; }
  }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { min-height: 44px; display: inline-flex; align-items: center; gap: 10px; padding: 0 18px; border-radius: 22px; background: var(--glass-light); font-size: 18px; }
  .chips span { color: var(--ink-soft); }

  .intimate { border-radius: 40px; background: var(--lagoon-deep); color: var(--air); padding: clamp(32px, 6vw, 88px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: clamp(32px, 5vw, 72px); }
  .kicker-light { color: var(--glass); }
  .intimate-text { font-size: clamp(19px, 1.8vw, 22px); line-height: 1.6; color: #E3EFEB; }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; align-self: center; }
  .checks li { background: rgba(255,255,255,0.07); border-radius: 22px; padding: 20px 24px 20px 58px; font-size: clamp(19px, 1.7vw, 21px); line-height: 1.45; position: relative; }
  .checks li::before { content: ''; position: absolute; left: 24px; top: 26px; width: 16px; height: 9px; border-left: 2.5px solid var(--glass); border-bottom: 2.5px solid var(--glass); transform: rotate(-45deg); }

  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }
  .card { background: var(--white); border-radius: var(--radius); padding: clamp(22px, 3vw, 30px); display: grid; gap: 8px; }
  .card h3 { font-size: 24px; }
  .card p { font-size: 20px; color: var(--ink-2); }

  .faq details { border-top: 1.5px solid var(--line); padding-block: 6px; }
