---
import { render } from 'astro:content';
import { articlePath, realReviewer, type Article } from '../lib/articles';
import { APP_URL, formatDate, ui, type Lang } from '../i18n/ui';
interface Props { entry: Article; others: Article[] }
const { entry, others } = Astro.props;
const d = entry.data;
const lang = d.lang as Lang;
const t = ui[lang];
const { Content } = await render(entry);
const reviewer = realReviewer(d.reviewer);
const updated = d.updated ?? d.published;
const appHref = APP_URL || `${t.home}#waitlist`;
---
<div class="wrap article-wrap">
  <nav class="crumbs" aria-label={lang === 'ru' ? 'Навигация' : 'Breadcrumb'}>
    <a href={t.home}>{t.breadcrumbHome}</a>
    <span aria-hidden="true">/</span>
    <a href={t.blog}>{t.blogTitle}</a>
  </nav>

  <div class="grid">
    <article class="article">
      <header class="art-head">
        <p class="meta">{d.topic} · {d.readingTime} {t.minRead}</p>
        <h1>{d.title}</h1>
        <p class="art-lead">{d.lead}</p>
        <p class="byline">
          {reviewer && <span>{t.reviewer}: {reviewer}</span>}
          <span>{t.updated}: <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated, lang)}</time></span>
        </p>
      </header>

      <div class="prose"><Content /></div>

      {d.flag && (
        <div class="flag" role="note">
          <strong>{t.dontWait}</strong>
          <p>{d.flag}</p>
        </div>
      )}

      {d.faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">{t.faqTitle}</h2>
          {d.faq.map((f) => (
            <div class="qa">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>
      )}

      {d.sources.length > 0 && (
        <section class="sources" aria-labelledby="src-title">
          <h2 id="src-title">{t.sourcesTitle}</h2>
          <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ol>
          <p>{t.blogFooterNote}</p>
        </section>
      )}
    </article>

    <aside class="aside">
      <section class="box box-glass">
        <h2>{t.inShort}</h2>
        <ul class="ticks">{d.summary.map((s) => <li>{s}</li>)}</ul>
      </section>

      {d.terms.length > 0 && (
        <section class="box">
          <h2>{t.termsTitle}</h2>
          <p class="small">{t.termsNote}</p>
          <dl class="terms">
            {d.terms.map((x) => (<div><dt>{x.term}</dt><dd lang={lang === 'ru' ? 'en' : 'ru'}>{x.translation}</dd></div>))}
          </dl>
        </section>
      )}

      <section class="box box-deep">
        <h2>{t.todayTitle}</h2>
        <p>{d.today}</p>
        <a class="btn btn-glass btn-sm" href={appHref} data-track="try_click" data-track-place="article">{t.openApp}</a>
      </section>

      {others.length > 0 && (
        <section class="box">
          <h2>{t.readNext}</h2>
          <ul class="next">
            {others.map((o) => (
              <li><a href={articlePath(lang, o.data.slug)}><span class="next-topic">{o.data.topic}</span><span class="next-title">{o.data.title}</span></a></li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</div>

<style>
  .article-wrap { padding-block: 24px clamp(64px, 8vw, 96px); display: grid; gap: 28px; }
  .crumbs { display: flex; gap: 10px; font-size: 17px; color: var(--ink-soft); }
  .crumbs a { color: var(--ink-soft); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(32px, 5vw, 80px); align-items: start; }
  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr; } }
  .article { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; max-width: 800px; }
  .art-head { display: grid; gap: 20px; padding-bottom: 28px; border-bottom: 1.5px solid var(--line); }
  .meta { font-size: 18px; font-weight: 600; color: var(--lagoon); }
  h1 { font: 600 clamp(36px, 5vw, 56px)/1.08 var(--serif); letter-spacing: -0.02em; }
  .art-lead { font: 400 clamp(21px, 2.1vw, 25px)/1.5 var(--serif); color: var(--ink-2); }
  .byline { display: flex; flex-wrap: wrap; gap: 6px 24px; font-size: 17px; color: var(--ink-soft); }

  .prose { font-size: clamp(19px, 1.7vw, 21px); line-height: 1.65; }
  .prose :global(h2) { font: 600 clamp(26px, 2.8vw, 32px)/1.2 var(--serif); margin: 40px 0 14px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; padding-left: 1.3em; display: grid; gap: 10px; }
  .prose :global(li::marker) { color: var(--lagoon); }

  .flag { border: 2px solid var(--brick); border-radius: 22px; padding: 24px 26px; background: var(--white); color: var(--brick-ink); display: grid; gap: 8px; }
  .flag strong { font-size: 19px; }
  .flag p { font-size: 20px; line-height: 1.55; }

  .faq { display: grid; gap: 18px; }
  .faq h2, .sources h2 { font: 600 26px/1.2 var(--serif); }
  .qa { background: var(--white); border-radius: 22px; padding: 22px 24px; display: grid; gap: 8px; }
  .qa h3 { font-size: 20px; }
  .qa p { font-size: 19px; color: var(--ink-2); }

  .sources { display: grid; gap: 12px; padding-top: 20px; border-top: 1.5px solid var(--line); font-size: 17px; color: var(--ink-soft); }
  .sources ol { margin: 0; padding-left: 22px; display: grid; gap: 8px; }

  .aside { display: grid; gap: 20px; position: sticky; top: 20px; }
  @media (max-width: 1000px) { .aside { position: static; } }
  .box { background: var(--white); border-radius: var(--radius); padding: 26px; display: grid; gap: 12px; }
  .box h2 { font: 700 22px/1.2 var(--sans); }
  .box-glass { background: var(--glass); }
  .box-deep { background: var(--lagoon-deep); color: var(--air); }
  .box-deep h2 { color: var(--glass); }
  .box-deep p { font-size: 19px; }
  .box .btn { justify-self: start; }
  .small { font-size: 17px; color: var(--ink-soft); }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ticks li { position: relative; padding-left: 32px; font-size: 19px; line-height: 1.45; }
  .ticks li::before { content: ''; position: absolute; left: 4px; top: 8px; width: 14px; height: 8px; border-left: 2.4px solid var(--lagoon-dark); border-bottom: 2.4px solid var(--lagoon-dark); transform: rotate(-45deg); }
  .terms { margin: 0; display: grid; }
  .terms div { padding: 12px 0; border-top: 1px solid var(--line-soft); display: grid; gap: 2px; }
  .terms dt { font-size: 19px; font-weight: 600; }
  .terms dd { margin: 0; font-size: 18px; color: var(--ink-soft); }
  .next { list-style: none; margin: 0; padding: 0; }
  .next a { display: grid; gap: 4px; padding: 12px 0; border-top: 1px solid var(--line-soft); color: var(--ink); text-decoration: none; }
  .next a:hover .next-title { text-decoration: underline; }
  .next-topic { font-size: 15px; font-weight: 600; color: var(--lagoon); }
  .next-title { font: 600 19px/1.3 var(--serif); }
</style>
