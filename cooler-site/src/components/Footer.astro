---
import { APP_NAME, CONTACT_EMAIL, ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang; note?: string; altHref: string }
const { lang, note, altHref } = Astro.props;
const t = ui[lang];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="disclaimer">
      <strong>{APP_NAME[lang]} {t.footerDisclaimerTitle}</strong>
      <p>{note ?? t.footerDisclaimer}</p>
    </div>
    <div class="footer-row">
      <span class="footer-brand">{APP_NAME[lang]}</span>
      <nav aria-label={t.footerAria}>
        <a href={t.blog}>{t.navBlog}</a>
        <a href={`${t.home}#privacy`}>{t.navPrivacy}</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>{t.footerContact}</a>
        <a href={altHref} hreflang={lang === 'ru' ? 'en' : 'ru'}>{lang === 'ru' ? 'English' : 'Русский'}</a>
      </nav>
      <span>© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
