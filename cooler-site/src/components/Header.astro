---
import Logo from './Logo.astro';
import { APP_NAME, APP_URL, ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang; altHref: string; current?: 'home' | 'blog' }
const { lang, altHref, current } = Astro.props;
const t = ui[lang];
const home = t.home;
const tryHref = APP_URL || `${home}#waitlist`;
---
<header class="wrap site-header">
  <a class="logo" href={home}><Logo /><span>{APP_NAME[lang]}</span></a>
  <nav class="site-nav" aria-label={t.navAria}>
    <a href={`${home}#features`}>{t.navFeatures}</a>
    <a href={`${home}#intimate`}>{t.navIntimate}</a>
    <a href={`${home}#privacy`}>{t.navPrivacy}</a>
    <a class="keep" href={t.blog} aria-current={current === 'blog' ? 'page' : undefined}>{t.navBlog}</a>
    <a href={`${home}#faq`}>{t.navFaq}</a>
  </nav>
  <div class="header-actions">
    <a class="lang" href={altHref} hreflang={lang === 'ru' ? 'en' : 'ru'} aria-label={t.langAria}>
      {lang === 'ru' ? <><strong>RU</strong>&nbsp;· EN</> : <>RU&nbsp;· <strong>EN</strong></>}
    </a>
    <a class="btn btn-primary btn-sm" href={tryHref} data-track="try_click" data-track-place="header">{t.tryFree}</a>
  </div>
</header>
