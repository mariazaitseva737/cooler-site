---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { APP_NAME } from '../i18n/ui';
---
<Base
  lang="ru"
  title={`${APP_NAME.ru} — приложение для женщин после менопаузы`}
  description="Приливы, сон, настроение, кости и сердце после менопаузы. Отметка дня за 30 секунд, понятные советы и честные знания. Бесплатно, данные остаются на телефоне."
  path="/"
  alternates={{ ru: '/', en: '/en/' }}
  current="home"
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: APP_NAME.ru, url: Astro.site?.href, inLanguage: 'ru' }]}
>
  <Landing lang="ru" />
</Base>
