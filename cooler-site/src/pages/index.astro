---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { APP_NAME } from '../i18n/ui';
---
<Base
  lang="en"
  title={`${APP_NAME.en}: a daily wellness practice for life after menopause`}
  description="A daily wellness practice for life after menopause: a 10-second check-in, short sessions for your body, clear answers about what’s normal and a summary for your doctor. Free, and your data stays on your phone."
  path="/"
  alternates={{ en: '/', ru: '/ru/' }}
  current="home"
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: APP_NAME.en, url: Astro.site?.href, inLanguage: 'en' }]}
>
  <Landing lang="en" />
</Base>
