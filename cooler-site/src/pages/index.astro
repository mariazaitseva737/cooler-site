---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { APP_NAME } from '../i18n/ui';
---
<Base
  lang="en"
  title={`${APP_NAME.en}: everything that keeps you feeling alive after menopause`}
  description="Dance and movement, meditation and brain training, personal astrology and a card of the day, and calm care for your health. Everything a woman needs to feel full and alive after menopause, in one app."
  path="/"
  alternates={{ en: '/', ru: '/ru/' }}
  current="home"
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: APP_NAME.en, url: Astro.site?.href, inLanguage: 'en' }]}
>
  <Landing lang="en" />
</Base>
