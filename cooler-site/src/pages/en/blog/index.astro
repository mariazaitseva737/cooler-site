---
import Base from '../../../layouts/Base.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { getArticles } from '../../../lib/articles';
import { APP_NAME, ui } from '../../../i18n/ui';
const lang = 'en';
const t = ui[lang];
const articles = await getArticles(lang);
const site = Astro.site!;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${t.blogTitle} — ${APP_NAME[lang]}`,
  description: t.blogDescription,
  inLanguage: lang,
  url: new URL(t.blog, site).href,
}];
---
<Base lang={lang} title={`${t.blogSeoTitle} | ${APP_NAME[lang]}`} description={t.blogDescription} path={t.blog}
  alternates={{ ru: '/blog/', en: '/en/blog/' }} current="blog" jsonLd={jsonLd} footerNote={t.blogFooterNote}>
  <BlogIndex lang={lang} articles={articles} />
</Base>
