---
import Base from '../../layouts/Base.astro';
import Landing from '../../components/Landing.astro';
import { APP_NAME } from '../../i18n/ui';
---
<Base
  lang="en"
  title={`${APP_NAME.en} — an app for women after menopause`}
  description="Hot flashes, sleep, mood, bones and heart health after menopause. Log your day in 30 seconds and get clear, honest guidance. Free, and your data stays on your phone."
  path="/en/"
  alternates={{ ru: '/', en: '/en/' }}
  current="home"
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: APP_NAME.en, url: new URL('/en/', Astro.site).href, inLanguage: 'en' }]}
>
  <Landing lang="en" />
</Base>
