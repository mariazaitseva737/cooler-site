---
import Base from '../../layouts/Base.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { articlePath, getArticles, getTranslation, type Article } from '../../lib/articles';
import { articleJsonLd } from '../../lib/seo';
import { APP_NAME, ui } from '../../i18n/ui';

export async function getStaticPaths() {
  const list = await getArticles('ru');
  return list.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, list } }));
}
const { entry, list } = Astro.props as { entry: Article; list: Article[] };
const d = entry.data;
const lang = 'ru';
const translation = await getTranslation(entry);
const alternates = {
  [lang]: articlePath(lang, d.slug),
  ...(translation ? { [translation.data.lang]: articlePath(translation.data.lang, translation.data.slug) } : {}),
};
const others = list.filter((a) => a.id !== entry.id).slice(0, 4);
---
<Base lang={lang} title={`${d.seoTitle} | ${APP_NAME[lang]}`} description={d.description} path={articlePath(lang, d.slug)}
  alternates={alternates} ogType="article" current="blog" jsonLd={articleJsonLd(entry, Astro.site!)} footerNote={ui[lang].blogFooterNote}>
  <ArticlePage entry={entry} others={others} />
</Base>
