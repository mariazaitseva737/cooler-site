---
import Base from '../../layouts/Base.astro';

const title = 'Come back to yourself: live masterclass with Mary';
const details = 'Free live masterclass on Zoom. The Zoom link will arrive by email.';
const gcal = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=20261121T230000Z/20261122T001500Z&details=${encodeURIComponent(details)}&location=Zoom`;
const ics = [
  'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Cooler//Masterclass//EN', 'BEGIN:VEVENT',
  'UID:masterclass-2026-11-21@cooler', 'DTSTAMP:20261106T000000Z',
  'DTSTART:20261121T230000Z', 'DTEND:20261122T001500Z',
  `SUMMARY:${title}`, `DESCRIPTION:${details}`, 'LOCATION:Zoom',
  'END:VEVENT', 'END:VCALENDAR',
].join('\r\n');
const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
---
<Base lang="en" title="You’re in!" description="Your spot at the masterclass is saved." path="/masterclass/thanks/" alternates={{ en: '/masterclass/thanks/' }} noindex>
  <section class="wrap mc-thanks">
    <p class="kicker">Saturday, November 21 · 6:00 PM ET</p>
    <h1>You’re in!</h1>
    <p>I’ll email you the Zoom link a day before, and again an hour before we start. Wear something comfy you can move in.</p>
    <div class="mc-cal">
      <a class="btn btn-primary" href={gcal} target="_blank" rel="noopener" data-track="masterclass_calendar" data-track-place="google">Add to Google Calendar</a>
      <a class="btn btn-outline" href={icsHref} download="masterclass.ics" data-track="masterclass_calendar" data-track-place="ics">Apple or Outlook calendar</a>
    </div>
    <a class="mc-back" href="/">See what we’re building at Cooler</a>
  </section>
</Base>

<style>
  .mc-thanks { padding-block: clamp(64px, 12vw, 140px); display: grid; gap: 22px; justify-items: start; max-width: 760px; }
  h1 { font: 700 clamp(40px, 6vw, 64px)/1.05 var(--sans); }
  p { font-size: 21px; line-height: 1.55; }
  .mc-cal { display: flex; flex-wrap: wrap; gap: 12px; }
  .mc-back { font-size: 19px; font-weight: 600; }
</style>
